{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "app.py"
        },
        {
            "src": "/(.*\\.(css|js|json|png|jpg|ico|xml|txt|html|webmanifest))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/$1"
        }
    ]
}